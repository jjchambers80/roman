{% comment %}
  Renders supplier-verified trust badges below the buy buttons.

  Claims per Vitelle Labs written confirmation (2026-07-20, ksenia@vitellelab.net):
  - Paraben-free: all formulas
  - Silicone-free: all formulas EXCEPT Revitalizing Serum (contains
    Cyclopentasiloxane + Dimethicone) — badge suppressed for that handle
  - Not tested on animals: finished products only (not ingredient-level;
    no cruelty-free certification wording permitted)
  - Small batch / freshly made: supplier-approved marketing angle

  Usage:
  {% render 'product-trust-badges', product: product %}
{% endcomment %}

{%- liquid
  # Fail closed: only formulas covered by the Vitelle 2026-07-20 INCI/claims
  # email may show badges. Products outside this list (e.g. pomegranate-eye-
  # patches) have no claim evidence and render nothing.
  assign claim_verified_handles = 'balancing-skin-cleanser-for-all-skin-types,gentle-cleansing-milk,gentle-toner,glass-glow-serum,ha-peptide-eye-creme,hyaluronic-serum-with-vitamin-e,hydrating-essence-with-hyaluronic-acid,illuminating-daily-serum-with-vitamin-c,multi-peptide-moisture-creme,revitalizing-serum-with-botanical-growth-factor' | split: ','
-%}
{%- if claim_verified_handles contains product.handle -%}
  {{ 'component-trust-badges.css' | asset_url | stylesheet_tag }}

  <ul class="trust-badges list-unstyled" aria-label="Product formula facts">
  <li class="trust-badges__item">
    <svg
      class="trust-badges__icon"
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      focusable="false"
    >
      <path d="M9.5 8.5C8.3 4.9 8.6 2 10.1 2c1.3 0 2 2.6 1.9 6"/>
      <path d="M14.5 8.5c1.2-3.6.9-6.5-.6-6.5-1.3 0-2 2.6-1.9 6"/>
      <circle cx="12" cy="15" r="6"/>
      <path d="M12 14.5v1"/>
    </svg>
    <span class="trust-badges__label">Not Tested on Animals</span>
  </li>
  <li class="trust-badges__item">
    <svg
      class="trust-badges__icon"
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      focusable="false"
    >
      <path d="M10 2v6.3L4.2 19.5A1.5 1.5 0 0 0 5.5 21.7h13a1.5 1.5 0 0 0 1.3-2.2L14 8.3V2"/>
      <path d="M8.5 2h7"/>
      <path d="M7.5 15h9"/>
    </svg>
    <span class="trust-badges__label">Paraben-Free</span>
  </li>
  {%- assign silicone_excluded_handles = 'revitalizing-serum-with-botanical-growth-factor,revitalizing-serum-with-growth-factor' | split: ',' -%}
  {%- unless silicone_excluded_handles contains product.handle -%}
    <li class="trust-badges__item">
      <svg
        class="trust-badges__icon"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        focusable="false"
      >
        <path d="M12 2.7c3.5 4.1 6 7.3 6 10.3a6 6 0 0 1-12 0c0-3 2.5-6.2 6-10.3z"/>
        <path d="M4 4l16 16"/>
      </svg>
      <span class="trust-badges__label">Silicone-Free</span>
    </li>
  {%- endunless -%}
  <li class="trust-badges__item">
    <svg
      class="trust-badges__icon"
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      focusable="false"
    >
      <path d="M12 3l1.7 5.2a2 2 0 0 0 1.3 1.3L20.2 11l-5.2 1.7a2 2 0 0 0-1.3 1.3L12 19.2l-1.7-5.2a2 2 0 0 0-1.3-1.3L3.8 11 9 9.5a2 2 0 0 0 1.3-1.3z"/>
      <path d="M19 16.5l.7 2 2 .7-2 .7-.7 2-.7-2-2-.7 2-.7z"/>
    </svg>
    <span class="trust-badges__label">Small Batch, Freshly Made</span>
  </li>
</ul>
{%- endif -%}
