{{ 'section-landing-morning.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Morning Defense System Landing Page
  A single section with hero + 4 product feature rows
{%- endcomment -%}

{%- comment -%} ===== Bundle variant collection ===== {%- endcomment -%}
{%- assign bundle_products = section.settings.bundle_products -%}
{%- assign fbt_total_price = 0 -%}
{%- assign fbt_total_compare = 0 -%}
{%- assign fbt_all_available = true -%}
{%- assign fbt_variant_ids = '' -%}

{%- for bp in bundle_products -%}
  {%- assign bp_variant = bp.selected_or_first_available_variant -%}
  {%- if bp_variant.available == false -%}
    {%- assign fbt_all_available = false -%}
  {%- endif -%}
  {%- assign fbt_total_price = fbt_total_price | plus: bp_variant.price -%}
  {%- if bp_variant.compare_at_price and bp_variant.compare_at_price > bp_variant.price -%}
    {%- assign fbt_total_compare = fbt_total_compare | plus: bp_variant.compare_at_price -%}
  {%- else -%}
    {%- assign fbt_total_compare = fbt_total_compare | plus: bp_variant.price -%}
  {%- endif -%}
  {%- if forloop.first -%}
    {%- assign fbt_variant_ids = bp_variant.id -%}
  {%- else -%}
    {%- assign fbt_variant_ids = fbt_variant_ids | append: ',' | append: bp_variant.id -%}
  {%- endif -%}
{%- endfor -%}

{%- assign fbt_discount = section.settings.discount_percentage -%}
{%- if fbt_discount > 0 -%}
  {%- assign fbt_multiplier = 100 | minus: fbt_discount -%}
  {%- assign fbt_discounted = fbt_total_price | times: fbt_multiplier | divided_by: 100 -%}
  {%- assign fbt_has_discount = true -%}
{%- else -%}
  {%- assign fbt_discounted = fbt_total_price -%}
  {%- assign fbt_has_discount = false -%}
{%- endif -%}

{%- assign fbt_show_compare = false -%}
{%- if fbt_has_discount and fbt_discounted < fbt_total_price -%}
  {%- assign fbt_show_compare = true -%}
  {%- assign fbt_display_price = fbt_discounted -%}
  {%- assign fbt_compare_price = fbt_total_price -%}
{%- elsif fbt_total_compare > fbt_total_price -%}
  {%- assign fbt_show_compare = true -%}
  {%- assign fbt_display_price = fbt_total_price -%}
  {%- assign fbt_compare_price = fbt_total_compare -%}
{%- else -%}
  {%- assign fbt_display_price = fbt_total_price -%}
{%- endif -%}

{%- comment -%} Build button label with optional discount %-{%- endcomment -%}
{%- assign btn_label = section.settings.button_label | default: 'Add Bundle' -%}
{%- if fbt_discount > 0 -%}
  {%- assign btn_label = btn_label | append: ' (' | append: fbt_discount | append: '% OFF)' -%}
{%- endif -%}

{%- comment -%} ===== HERO BANNER ===== {%- endcomment -%}
<frequently-bought-together class="landing-hero-bundle-wrapper">
<div class="landing-hero">
  <div class="landing-hero__inner">
    <div class="landing-hero__content">
      <h1 class="landing-hero__heading">Morning Defense System</h1>
      <p class="landing-hero__text">
        Start every morning with a four-step ritual that cleanses, tones, shields, and revitalizes. Our peptide-powered Balancing Cleanser, ultra-mild Gentle Toner, Vitamin&nbsp;C Illuminating Serum, and Multi-Peptide Moisture Crème work in concert to protect against daily aggressors, restore radiance, and deeply hydrate—so your skin faces the day fortified, luminous, and visibly firmer.
      </p>

      {%- if bundle_products.size > 0 -%}
        <div class="landing-hero__bundle">
          <button
            type="button"
            class="landing-hero__cta landing-hero__cta--button"
            data-bundle-add
            data-variant-ids='[{{ fbt_variant_ids }}]'
            {% unless fbt_all_available %}aria-disabled="true"{% endunless %}
          >
            <span class="landing-hero__cta-label">
              {%- if fbt_all_available -%}
                {{ btn_label }}
              {%- else -%}
                Sold Out
              {%- endif -%}
            </span>
            <div class="loading__spinner hidden">
              {%- render 'loading-spinner' -%}
            </div>
          </button>

          <div class="landing-hero__price-row">
            <span class="landing-hero__price-sale">{{ fbt_display_price | money_with_currency }}</span>
            {%- if fbt_show_compare -%}
              <s class="landing-hero__price-compare">{{ fbt_compare_price | money_with_currency }}</s>
            {%- endif -%}
          </div>

          {%- if fbt_discount > 0 -%}
            <p class="landing-hero__discount-note">
              {{ fbt_discount }}% bundle discount applied automatically at checkout
            </p>
          {%- endif -%}

          <div class="frequently-bought-together__error" role="alert"></div>
        </div>
      {%- else -%}
        <a href="#product-1" class="landing-hero__cta">Explore the Routine</a>
      {%- endif -%}
    </div>
    <div class="landing-hero__media">
      <img
        src="{{ 'morning-routine-1.png' | asset_url }}"
        alt="Roman Skin Morning Defense System bundle"
        loading="eager"
        fetchpriority="high"
        class="landing-hero__image"
        width="900"
        height="900"
      >
    </div>
  </div>
</div>

</frequently-bought-together>

{%- comment -%} ===== PRODUCT 1: CLEANSER (image left) ===== {%- endcomment -%}
<div id="product-1" class="landing-product">
  <div class="landing-product__inner">
    <div class="landing-product__media">
      <img
        src="{{ 'ROMAN-CLEANSER-FOR-ALL-SKIN-TYPES.webp' | asset_url }}"
        alt="Roman Skin Balancing Skin Cleanser for All Skin Types"
        loading="lazy"
        class="landing-product__image"
        width="800"
        height="800"
      >
    </div>
    <div class="landing-product__content">
      <span class="landing-product__eyebrow">Step 1 — Cleanse</span>
      <h2 class="landing-product__heading">Balancing Skin Cleanser for All Skin Types</h2>
      <p class="landing-product__text">
        Wake up your skin with a gentle foaming wash that doesn't just clean—it revives. Infused with Cranberry Seed Oil, Rooibos, and Green Tea, this cleanser sweeps away overnight buildup while restoring moisture and balance. Skin is left feeling uplifted, vibrant, and perfectly prepped for the actives that follow.
      </p>
      <p class="landing-product__usage">
        Wet hands, face & décolleté. Massage foaming cleanser in gentle sweeping motions. Rinse with warm water.
      </p>
      <a href="/products/balancing-skin-cleanser-for-all-skin-types" class="landing-product__cta">View Product</a>
    </div>
  </div>
</div>

{%- comment -%} ===== PRODUCT 2: GENTLE TONER (image right) ===== {%- endcomment -%}
<div class="landing-product landing-product--alt landing-product--image-right">
  <div class="landing-product__inner">
    <div class="landing-product__media">
      <img
        src="{{ 'gentle-toner (2).webp' | asset_url }}"
        alt="Roman Skin Gentle Toner for Ultra-Sensitive Skin"
        loading="lazy"
        class="landing-product__image"
        width="800"
        height="800"
      >
    </div>
    <div class="landing-product__content">
      <span class="landing-product__eyebrow">Step 2 — Tone & Calm</span>
      <div class="landing-product__skin-badge">
        <span class="landing-product__badge-icon">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        </span>
        Ultra-Sensitive &middot; Dry/Sensitive Skin
      </div>
      <h2 class="landing-product__heading">Gentle Toner</h2>
      <p class="landing-product__text">
        The quiet reset your skin has been craving. This ultra-mild botanical toner doesn't just hydrate—it whispers calm into every pore. pH-balanced and entirely free of color, fragrance, and parabens, it delivers a concentrated burst of soothing botanicals that fortify your moisture barrier without a trace of irritation. Think of it as a deep breath for reactive skin: balancing, nourishing, and impossibly gentle.
      </p>
      <p class="landing-product__usage">
        After cleansing, sweep across face and décolleté with a cotton pad. Removes residual cleanser, makeup, and hard-water minerals while infusing skin with active botanical nourishment. Follow with your targeted serum.
      </p>
      <a href="/products/gentle-toner" class="landing-product__cta">View Product</a>
    </div>
  </div>
</div>

{%- comment -%} ===== PRODUCT 3: SERUM (image left) ===== {%- endcomment -%}
<div class="landing-product">
  <div class="landing-product__inner">
    <div class="landing-product__media">
      <img
        src="{{ 'ROMAN-Daily-serum.webp' | asset_url }}"
        alt="Roman Skin Illuminating Daily Serum with Vitamin C"
        loading="lazy"
        class="landing-product__image"
        width="800"
        height="800"
      >
    </div>
    <div class="landing-product__content">
      <span class="landing-product__eyebrow">Step 3 — Protect & Illuminate</span>
      <h2 class="landing-product__heading">Illuminating Daily Serum with Vitamin C</h2>
      <p class="landing-product__text">
        Your daily armor against environmental stress. This peptide-enriched antioxidant serum harnesses the power of Ameliox™&nbsp;Complex, Astaxanthin, Ferulic Acid, Kakadu Plum, and Emblica to neutralize free radicals and amplify your skin's natural glow. Texture refines, luminosity builds, and your complexion stays protected from morning to night.
      </p>
      <p class="landing-product__usage">
        AM & PM — Apply 2–3 drops to face & décolleté after cleansing. Allow to absorb fully.
      </p>
      <a href="/products/illuminating-daily-serum-with-vitamin-c" class="landing-product__cta">View Product</a>
    </div>
  </div>
</div>

{%- comment -%} ===== PRODUCT 4: MOISTURE CRÈME (image right) ===== {%- endcomment -%}
<div class="landing-product landing-product--alt landing-product--image-right">
  <div class="landing-product__inner">
    <div class="landing-product__media">
      <img
        src="{{ 'peptide-moisturizer.png' | asset_url }}"
        alt="Roman Skin Multi-Peptide Moisture Crème"
        loading="lazy"
        class="landing-product__image"
        width="800"
        height="800"
      >
    </div>
    <div class="landing-product__content">
      <span class="landing-product__eyebrow">Step 4 — Hydrate & Revitalize</span>
      <h2 class="landing-product__heading">Multi-Peptide Moisture Crème</h2>
      <p class="landing-product__text">
        Support skin with this luxurious Crème offering the transformative power of Hexa and Tetrapeptides that help renew the look of skin. Moisture-rich Sodium Hyaluronate and Aloe Vera encourage glowing skin that is superbly hydrated. Natural-source lipids help to revive the complexion and combat dryness for skin that looks and feels softer and more supple.
      </p>
      <p class="landing-product__usage">
        After cleansing and toning, warm a small amount between palms and smooth over face and neck.
      </p>
      <a href="/products/multi-peptide-moisture-creme" class="landing-product__cta">View Product</a>
    </div>
  </div>
</div>

<script src="{{ 'frequently-bought-together.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Morning Defense",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "product_list",
      "id": "bundle_products",
      "label": "Bundle products",
      "limit": 4
    },
    {
      "type": "range",
      "id": "discount_percentage",
      "label": "Bundle discount %",
      "min": 0,
      "max": 30,
      "step": 5,
      "default": 0,
      "info": "Display-only. Pair with a Shopify automatic discount."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Add Bundle"
    }
  ],
  "presets": [
    {
      "name": "Morning Defense"
    }
  ]
}
{% endschema %}
