{{ 'section-frequently-bought-together.css' | asset_url | stylesheet_tag }}
<div class="page-width section-{{ section.id }}-padding">
  {%- render 'frequently-bought-together',
    product: product,
    bundle_products: section.settings.bundle_products,
    heading: section.settings.heading,
    discount_percentage: section.settings.discount_percentage,
    discount_code: section.settings.discount_code,
    button_label: section.settings.button_label,
    experience_version: section.settings.experience_version,
    shopify_attributes: section.shopify_attributes
  -%}
</div>
<script src="{{ 'frequently-bought-together.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  .section-{{ section.id }}-padding { padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; }
{%- endstyle -%}

{% schema %}
{
  "name": "PDP bought together",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Frequently Bought Together" },
    { "type": "product_list", "id": "bundle_products", "label": "Bundle products", "limit": 4 },
    { "type": "range", "id": "discount_percentage", "label": "Bundle discount", "min": 0, "max": 30, "step": 5, "default": 0, "unit": "%" },
    { "type": "text", "id": "discount_code", "label": "Discount code" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Add Bundle" },
    { "type": "text", "id": "experience_version", "label": "Analytics experience", "default": "default" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 40 }
  ],
  "presets": [{ "name": "PDP bought together" }]
}
{% endschema %}
