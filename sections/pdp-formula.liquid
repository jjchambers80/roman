{%- style -%}
  #shopify-section-{{ section.id }} .pdp-formula { padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px; }
  #shopify-section-{{ section.id }} .pdp-formula__intro { max-width: 68rem; margin: 0 auto 3rem; text-align: center; }
  #shopify-section-{{ section.id }} .pdp-formula__intro h2 { margin: 0 0 1rem; }
  #shopify-section-{{ section.id }} .pdp-formula__grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.5rem; }
  #shopify-section-{{ section.id }} .pdp-formula__item { padding: 2.4rem; border: 1px solid rgba(var(--color-foreground), .14); background: rgb(var(--color-background)); }
  #shopify-section-{{ section.id }} .pdp-formula__item h3 { margin: 0 0 .7rem; font-size: 1.8rem; }
  #shopify-section-{{ section.id }} .pdp-formula__item p { margin: 0; }
  @media screen and (max-width: 749px) { #shopify-section-{{ section.id }} .pdp-formula__grid { grid-template-columns: 1fr; } }
{%- endstyle -%}

<section class="pdp-formula color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    <div class="pdp-formula__intro">
      <h2 class="h1">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.subheading != blank -%}<p>{{ section.settings.subheading | escape }}</p>{%- endif -%}
    </div>
    <div class="pdp-formula__grid">
      {%- for block in section.blocks -%}
        <article class="pdp-formula__item" {{ block.shopify_attributes }}>
          <h3>{{ block.settings.heading | escape }}</h3>
          <p>{{ block.settings.text | escape }}</p>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{"name":"PDP formula","settings":[{"type":"text","id":"heading","label":"Heading","default":"Why this formula"},{"type":"text","id":"subheading","label":"Subheading"},{"type":"color_scheme","id":"color_scheme","label":"Color scheme","default":"scheme-1"},{"type":"range","id":"padding_top","min":0,"max":100,"step":4,"unit":"px","label":"Top padding","default":52},{"type":"range","id":"padding_bottom","min":0,"max":100,"step":4,"unit":"px","label":"Bottom padding","default":52}],"blocks":[{"type":"ingredient","name":"Ingredient role","settings":[{"type":"text","id":"heading","label":"Ingredient"},{"type":"text","id":"text","label":"Customer value"}]}],"max_blocks":4,"presets":[{"name":"PDP formula"}]}
{% endschema %}
