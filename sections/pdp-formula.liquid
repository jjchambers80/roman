{%- style -%}
  #shopify-section-{{ section.id }} .pdp-formula { padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px; }
  #shopify-section-{{ section.id }} .pdp-formula__intro { max-width: 68rem; margin: 0 auto 3rem; text-align: center; }
  #shopify-section-{{ section.id }} .pdp-formula__intro h2 { margin: 0 0 1rem; }
  #shopify-section-{{ section.id }} .pdp-formula__grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.5rem; }
  #shopify-section-{{ section.id }} .pdp-formula__item { padding: 2.4rem; border: 1px solid rgba(var(--color-foreground), .14); background: rgb(var(--color-background)); }
  #shopify-section-{{ section.id }} .pdp-formula__item h3 { margin: 0 0 .7rem; font-size: 1.8rem; }
  #shopify-section-{{ section.id }} .pdp-formula__item p { margin: 0; }
  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .pdp-formula__grid { grid-template-columns: 1fr; }
    #shopify-section-{{ section.id }} .pdp-formula__item { padding: 1.8rem; }
    #shopify-section-{{ section.id }} .pdp-formula__intro { margin-bottom: 2rem; }
  }
{%- endstyle -%}

{%- liquid
  assign formula_json = product.metafields.custom.why_this_formula.value
  if formula_json
    assign formula_subheading = formula_json.subheading
    assign formula_points = formula_json.points
  endif
-%}

{%- if formula_points.size > 0 or section.blocks.size > 0 -%}
<section class="pdp-formula color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    <div class="pdp-formula__intro">
      <h2 class="h1">{{ section.settings.heading | escape }}</h2>
      {%- if formula_subheading != blank -%}
        <p>{{ formula_subheading | escape }}</p>
      {%- elsif section.settings.subheading != blank -%}
        <p>{{ section.settings.subheading | escape }}</p>
      {%- endif -%}
    </div>
    <div class="pdp-formula__grid">
      {%- if formula_points.size > 0 -%}
        {%- for point in formula_points limit: 4 -%}
          <article class="pdp-formula__item">
            <h3>{{ point.heading | escape }}</h3>
            <p>{{ point.text | escape }}</p>
          </article>
        {%- endfor -%}
      {%- else -%}
        {%- for block in section.blocks -%}
          <article class="pdp-formula__item" {{ block.shopify_attributes }}>
            <h3>{{ block.settings.heading | escape }}</h3>
            <p>{{ block.settings.text | escape }}</p>
          </article>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{"name":"PDP formula","settings":[{"type":"text","id":"heading","label":"Heading","default":"Why this formula"},{"type":"text","id":"subheading","label":"Subheading","info":"Fallback used only when the product has no custom.why_this_formula metafield."},{"type":"color_scheme","id":"color_scheme","label":"Color scheme","default":"scheme-1"},{"type":"range","id":"padding_top","min":0,"max":100,"step":4,"unit":"px","label":"Top padding","default":52},{"type":"range","id":"padding_bottom","min":0,"max":100,"step":4,"unit":"px","label":"Bottom padding","default":52}],"blocks":[{"type":"ingredient","name":"Ingredient role","settings":[{"type":"text","id":"heading","label":"Ingredient"},{"type":"text","id":"text","label":"Customer value"}]}],"max_blocks":4,"presets":[{"name":"PDP formula"}]}
{% endschema %}
