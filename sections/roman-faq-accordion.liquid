{%- comment -%}
  Roman Skin Care FAQ Accordion Section
  Accessible, mobile-first, block-based FAQ with optional category filtering,
  JSON-LD schema, and contact CTA.
{%- endcomment -%}

{%- style -%}
  /* === Roman FAQ Accordion === */
  .roman-faq {
    max-width: 82rem;
    margin: 0 auto;
    padding: 5rem 2rem 6rem;
    font-family: inherit;
  }

  .roman-faq__header {
    text-align: center;
    margin-bottom: 3.6rem;
  }

  .roman-faq__heading {
    font-size: 3.2rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: #1a1a1a;
    margin: 0 0 1.2rem;
  }

  .roman-faq__subheading {
    font-size: 1.5rem;
    line-height: 1.7;
    color: #5a5a5a;
    margin: 0 auto;
    max-width: 60rem;
  }

  .roman-faq__subheading p {
    margin: 0;
  }

  /* Category filter tabs */
  .roman-faq__filters {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.8rem;
    margin-bottom: 3rem;
  }

  .roman-faq__filter-btn {
    font: inherit;
    font-size: 1.3rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    padding: 0.7rem 1.6rem;
    border: 1px solid #d4d4d4;
    border-radius: 100rem;
    background: transparent;
    color: #4a4a4a;
    cursor: pointer;
    transition: background-color 0.2s, color 0.2s, border-color 0.2s;
    white-space: nowrap;
  }

  .roman-faq__filter-btn:hover {
    border-color: #6D796E;
    color: #6D796E;
  }

  .roman-faq__filter-btn[aria-pressed="true"] {
    background-color: #6D796E;
    border-color: #6D796E;
    color: #fff;
  }

  /* Accordion list */
  .roman-faq__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid #e5e5e5;
  }

  .roman-faq__item {
    border-bottom: 1px solid #e5e5e5;
  }

  .roman-faq__item[hidden] {
    display: none;
  }

  .roman-faq__question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 1.8rem 0.4rem;
    font: inherit;
    font-size: 1.55rem;
    font-weight: 600;
    line-height: 1.4;
    color: #1a1a1a;
    background: none;
    border: none;
    cursor: pointer;
    text-align: left;
    gap: 1.6rem;
    min-height: 4.4rem;
  }

  .roman-faq__question:hover {
    color: #6D796E;
  }

  .roman-faq__question:focus-visible {
    outline: 2px solid #6D796E;
    outline-offset: 2px;
    border-radius: 2px;
  }

  .roman-faq__icon {
    flex-shrink: 0;
    width: 2rem;
    height: 2rem;
    transition: transform 0.25s ease;
  }

  .roman-faq__question[aria-expanded="true"] .roman-faq__icon {
    transform: rotate(45deg);
  }

  .roman-faq__answer {
    overflow: hidden;
    transition: max-height 0.3s ease, padding 0.3s ease;
    max-height: 0;
    padding: 0 0.4rem;
  }

  .roman-faq__answer[hidden] {
    display: none;
  }

  .roman-faq__answer:not([hidden]) {
    display: block;
    max-height: 80rem;
    padding: 0 0.4rem 2rem;
  }

  .roman-faq__answer-inner {
    font-size: 1.45rem;
    line-height: 1.75;
    color: #4a4a4a;
  }

  .roman-faq__answer-inner p {
    margin: 0 0 1rem;
  }

  .roman-faq__answer-inner p:last-child {
    margin-bottom: 0;
  }

  /* Contact CTA */
  .roman-faq__cta {
    text-align: center;
    margin-top: 4.5rem;
    padding: 3.5rem 2rem;
    background-color: #f9f8f6;
    border-radius: 0.6rem;
  }

  .roman-faq__cta-heading {
    font-size: 2.2rem;
    font-weight: 700;
    color: #1a1a1a;
    margin: 0 0 1rem;
  }

  .roman-faq__cta-body {
    font-size: 1.45rem;
    line-height: 1.7;
    color: #5a5a5a;
    margin: 0 0 2rem;
    max-width: 48rem;
    margin-left: auto;
    margin-right: auto;
  }

  .roman-faq__cta-body p {
    margin: 0;
  }

  .roman-faq__cta-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 20rem;
    padding: 1.2rem 3rem;
    font: inherit;
    font-size: 1.4rem;
    font-weight: 600;
    text-decoration: none;
    background-color: #6D796E;
    border: 1px solid #6D796E;
    color: #fff;
    border-radius: 0;
    cursor: pointer;
    transition: background-color 0.2s, border-color 0.2s;
  }

  .roman-faq__cta-button:hover {
    background-color: #5e6150;
    border-color: #5e6150;
  }

  /* Responsive */
  @media screen and (max-width: 749px) {
    .roman-faq {
      padding: 3rem 1.5rem 4rem;
    }

    .roman-faq__heading {
      font-size: 2.6rem;
    }

    .roman-faq__subheading {
      font-size: 1.4rem;
    }

    .roman-faq__question {
      font-size: 1.45rem;
      padding: 1.5rem 0.2rem;
    }

    .roman-faq__answer-inner {
      font-size: 1.35rem;
    }

    .roman-faq__cta {
      padding: 2.5rem 1.5rem;
    }

    .roman-faq__cta-heading {
      font-size: 1.8rem;
    }
  }
{%- endstyle -%}

<div class="roman-faq">
  {%- comment -%} Header {%- endcomment -%}
  <div class="roman-faq__header">
    {%- if section.settings.heading != blank -%}
      <h1 class="roman-faq__heading">{{ section.settings.heading | escape }}</h1>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <div class="roman-faq__subheading">{{ section.settings.subheading }}</div>
    {%- endif -%}
  </div>

  {%- comment -%} Collect categories {%- endcomment -%}
  {%- assign has_categories = false -%}
  {%- assign category_list = '' -%}
  {%- for block in section.blocks -%}
    {%- if block.settings.category != blank and block.settings.category != 'none' -%}
      {%- assign has_categories = true -%}
      {%- unless category_list contains block.settings.category -%}
        {%- if category_list == '' -%}
          {%- assign category_list = block.settings.category -%}
        {%- else -%}
          {%- assign category_list = category_list | append: '|' | append: block.settings.category -%}
        {%- endif -%}
      {%- endunless -%}
    {%- endif -%}
  {%- endfor -%}
  {%- assign categories = category_list | split: '|' -%}

  {%- if has_categories and categories.size > 1 -%}
    <div class="roman-faq__filters" role="tablist" aria-label="FAQ categories">
      <button type="button" class="roman-faq__filter-btn" aria-pressed="true" data-faq-filter="all">All</button>
      {%- for cat in categories -%}
        {%- case cat -%}
          {%- when 'orders_shipping' -%}
            {%- assign cat_label = 'Orders & Shipping' -%}
          {%- when 'returns_refunds' -%}
            {%- assign cat_label = 'Returns & Refunds' -%}
          {%- when 'products_usage' -%}
            {%- assign cat_label = 'Products & Usage' -%}
          {%- when 'account_payments' -%}
            {%- assign cat_label = 'Account & Payments' -%}
          {%- else -%}
            {%- assign cat_label = cat | replace: '_', ' ' | capitalize -%}
        {%- endcase -%}
        <button type="button" class="roman-faq__filter-btn" aria-pressed="false" data-faq-filter="{{ cat }}">{{ cat_label }}</button>
      {%- endfor -%}
    </div>
  {%- endif -%}

  {%- comment -%} Accordion list {%- endcomment -%}
  <ul class="roman-faq__list" data-faq-accordion data-allow-multiple="{{ section.settings.allow_multiple_open }}">
    {%- for block in section.blocks -%}
      {%- if block.type == 'faq_item' -%}
        <li
          class="roman-faq__item"
          data-faq-category="{{ block.settings.category | default: 'none' }}"
          {{ block.shopify_attributes }}
        >
          <button
            type="button"
            class="roman-faq__question"
            id="faq-button-{{ block.id }}"
            aria-expanded="false"
            aria-controls="faq-panel-{{ block.id }}"
          >
            <span>{{ block.settings.question | escape }}</span>
            <svg class="roman-faq__icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <line x1="10" y1="4" x2="10" y2="16"/>
              <line x1="4" y1="10" x2="16" y2="10"/>
            </svg>
          </button>
          <div
            id="faq-panel-{{ block.id }}"
            role="region"
            aria-labelledby="faq-button-{{ block.id }}"
            class="roman-faq__answer"
            hidden
          >
            <div class="roman-faq__answer-inner">{{ block.settings.answer }}</div>
          </div>
        </li>
      {%- endif -%}
    {%- endfor -%}
  </ul>

  {%- comment -%} Contact CTA {%- endcomment -%}
  {%- if section.settings.show_cta -%}
    <div class="roman-faq__cta">
      {%- if section.settings.cta_heading != blank -%}
        <h2 class="roman-faq__cta-heading">{{ section.settings.cta_heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.cta_body != blank -%}
        <div class="roman-faq__cta-body">{{ section.settings.cta_body }}</div>
      {%- endif -%}
      {%- if section.settings.cta_button_label != blank and section.settings.cta_button_link != blank -%}
        <a href="{{ section.settings.cta_button_link }}" class="roman-faq__cta-button">
          {{ section.settings.cta_button_label | escape }}
        </a>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- comment -%} JSON-LD FAQ Schema {%- endcomment -%}
  {%- if section.settings.enable_faq_schema -%}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [
          {%- for block in section.blocks -%}
            {%- if block.type == 'faq_item' -%}
              {
                "@type": "Question",
                "name": {{ block.settings.question | json }},
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": {{ block.settings.answer | strip_html | json }}
                }
              }{%- unless forloop.last -%},{%- endunless -%}
            {%- endif -%}
          {%- endfor -%}
        ]
      }
    </script>
  {%- endif -%}
</div>

<script>
  (function() {
    const wrapper = document.querySelector('[data-faq-accordion]');
    if (!wrapper) return;

    const allowMultiple = wrapper.dataset.allowMultiple === 'true';

    /* Accordion toggle via event delegation */
    wrapper.addEventListener('click', function(e) {
      const btn = e.target.closest('.roman-faq__question');
      if (!btn) return;

      const expanded = btn.getAttribute('aria-expanded') === 'true';
      const panelId = btn.getAttribute('aria-controls');
      const panel = document.getElementById(panelId);
      if (!panel) return;

      if (!allowMultiple && !expanded) {
        wrapper.querySelectorAll('.roman-faq__question[aria-expanded="true"]').forEach(function(openBtn) {
          openBtn.setAttribute('aria-expanded', 'false');
          var openPanel = document.getElementById(openBtn.getAttribute('aria-controls'));
          if (openPanel) openPanel.setAttribute('hidden', '');
        });
      }

      btn.setAttribute('aria-expanded', expanded ? 'false' : 'true');
      if (expanded) {
        panel.setAttribute('hidden', '');
      } else {
        panel.removeAttribute('hidden');
      }
    });

    /* Keyboard arrow navigation between questions */
    wrapper.addEventListener('keydown', function(e) {
      if (e.key !== 'ArrowDown' && e.key !== 'ArrowUp') return;
      const buttons = Array.from(wrapper.querySelectorAll('.roman-faq__question:not([hidden])'));
      const current = buttons.indexOf(document.activeElement);
      if (current === -1) return;
      e.preventDefault();
      var next;
      if (e.key === 'ArrowDown') {
        next = current + 1 < buttons.length ? current + 1 : 0;
      } else {
        next = current - 1 >= 0 ? current - 1 : buttons.length - 1;
      }
      buttons[next].focus();
    });

    /* Category filters */
    var filterWrap = document.querySelector('.roman-faq__filters');
    if (filterWrap) {
      filterWrap.addEventListener('click', function(e) {
        var btn = e.target.closest('.roman-faq__filter-btn');
        if (!btn) return;
        var filter = btn.dataset.faqFilter;

        filterWrap.querySelectorAll('.roman-faq__filter-btn').forEach(function(b) {
          b.setAttribute('aria-pressed', 'false');
        });
        btn.setAttribute('aria-pressed', 'true');

        wrapper.querySelectorAll('.roman-faq__item').forEach(function(item) {
          if (filter === 'all' || item.dataset.faqCategory === filter) {
            item.removeAttribute('hidden');
          } else {
            item.setAttribute('hidden', '');
          }
        });
      });
    }
  })();
</script>

{% schema %}
{
  "name": "FAQ Accordion",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently Asked Questions"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>Quick answers to common questions about ordering, shipping, returns, and how to use Roman Skin Care in a routine.</p>"
    },
    {
      "type": "checkbox",
      "id": "allow_multiple_open",
      "label": "Allow multiple panels open",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "enable_faq_schema",
      "label": "Enable FAQ JSON-LD schema",
      "info": "Adds structured data for search engines.",
      "default": true
    },
    {
      "type": "header",
      "content": "Contact CTA"
    },
    {
      "type": "checkbox",
      "id": "show_cta",
      "label": "Show contact CTA",
      "default": true
    },
    {
      "type": "text",
