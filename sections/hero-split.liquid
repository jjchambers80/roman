{{ 'section-hero-split.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="hero-split section-{{ section.id }}-padding">
  <div class="hero-split__inner">
    {%- comment -%} Text column {%- endcomment -%}
    <div class="hero-split__content">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'kicker' -%}
            {%- if block.settings.kicker != blank -%}
              <span class="hero-split__kicker" {{ block.shopify_attributes }}>{{ block.settings.kicker | escape }}</span>
            {%- endif -%}

          {%- when 'heading' -%}
            <h1 class="hero-split__heading" {{ block.shopify_attributes }}>
              {%- if block.settings.heading_line_1 != blank -%}
                <span class="hero-split__heading-primary">{{ block.settings.heading_line_1 | escape }}</span>
              {%- endif -%}
              {%- if block.settings.heading_accent != blank -%}
                <span class="hero-split__heading-accent">{{ block.settings.heading_accent | escape }}</span>
              {%- endif -%}
            </h1>

          {%- when 'subheading' -%}
            {%- if block.settings.subheading != blank -%}
              <p class="hero-split__subheading" {{ block.shopify_attributes }}>{{ block.settings.subheading | escape }}</p>
            {%- endif -%}

          {%- when 'text' -%}
            <div class="hero-split__text" {{ block.shopify_attributes }}>
              {%- if block.settings.text_highlight != blank -%}
                <span class="hero-split__text-highlight">{{ block.settings.text_highlight | escape }}</span>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                {{ block.settings.text }}
              {%- endif -%}
            </div>

          {%- when 'buttons' -%}
            <div class="hero-split__buttons" {{ block.shopify_attributes }}>
              {%- if block.settings.button_label_1 != blank -%}
                <a
                  href="{{ block.settings.button_link_1 | default: '#' }}"
                  class="button{% if block.settings.button_style_secondary_1 %} button--secondary{% else %} button--primary{% endif %}"
                >
                  {{ block.settings.button_label_1 | escape }}
                </a>
              {%- endif -%}
              {%- if block.settings.button_label_2 != blank -%}
                <a
                  href="{{ block.settings.button_link_2 | default: '#' }}"
                  class="button{% if block.settings.button_style_secondary_2 %} button--secondary{% else %} button--primary{% endif %}"
                >
                  {{ block.settings.button_label_2 | escape }}
                </a>
              {%- endif -%}
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>

    {%- comment -%} Image column {%- endcomment -%}
    <div class="hero-split__media">
      {%- if section.settings.image != blank -%}
        <img
          src="{{ section.settings.image | image_url: width: 900 }}"
          srcset="{{ section.settings.image | image_url: width: 500 }} 500w,
                  {{ section.settings.image | image_url: width: 700 }} 700w,
                  {{ section.settings.image | image_url: width: 900 }} 900w,
                  {{ section.settings.image | image_url: width: 1200 }} 1200w"
          sizes="(max-width: 989px) 100vw, 50vw"
          alt="{{ section.settings.image.alt | default: 'Hero image' }}"
          loading="eager"
          fetchpriority="high"
          class="hero-split__image"
          width="{{ section.settings.image.width }}"
          height="{{ section.settings.image.height }}"
        >
      {%- elsif section.settings.asset_image != blank -%}
        <img
          src="{{ section.settings.asset_image | asset_url }}"
          alt="Hero image"
          loading="eager"
          fetchpriority="high"
          class="hero-split__image"
          width="900"
          height="900"
        >
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'hero-split__image' }}
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Hero Split",
  "tag": "section",
  "class": "section",
  "limit": 1,
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "asset_image",
      "label": "Asset image filename (fallback)",
      "info": "Enter the filename from assets/ (e.g. my-image.png). Used if no image is picked above."
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "kicker",
      "name": "Kicker / Eyebrow",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "kicker",
          "label": "Kicker text",
          "default": "PROFESSIONAL-GRADE SKINCARE"
        }
      ]
    },
    {
      "type": "heading",
      "name": "Heading",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading_line_1",
          "label": "Heading line 1",
          "default": "YOUR BEST SKIN,"
        },
        {
          "type": "text",
          "id": "heading_accent",
          "label": "Heading accent line",
          "default": "DELIVERED."
        }
      ]
    },
    {
      "type": "subheading",
      "name": "Subheading",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "subheading",
          "label": "Subheading",
          "default": "CLINICALLY INSPIRED. NEVER COMPROMISED."
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "text_highlight",
          "label": "Highlighted phrase (accent color)",
          "default": "Peptide-enriched. Antioxidant-fortified."
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "Built on 30+ years of clinical esthetics mastery—every ingredient earns its place, every formula delivers visible results."
        }
      ]
    },
    {
      "type": "buttons",
      "name": "Buttons",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "button_label_1",
          "label": "Primary button label",
          "default": "SHOP BEST SELLERS"
        },
        {
          "type": "url",
          "id": "button_link_1",
          "label": "Primary button link"
        },
        {
          "type": "checkbox",
          "id": "button_style_secondary_1",
          "label": "Use outline style",
          "default": false
        },
        {
          "type": "text",
          "id": "button_label_2",
          "label": "Secondary button label",
          "default": "EXPLORE ROUTINES"
        },
        {
          "type": "url",
          "id": "button_link_2",
          "label": "Secondary button link"
        },
        {
          "type": "checkbox",
          "id": "button_style_secondary_2",
          "label": "Use outline style",
          "default": true
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero Split",
      "blocks": [
        { "type": "kicker" },
        { "type": "heading" },
        { "type": "subheading" },
        { "type": "text" },
        { "type": "buttons" }
      ]
    }
  ]
}
{% endschema %}
