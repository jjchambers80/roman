{%- style -%}
  .trust-strip {
    background-color: {{ section.settings.background_color }};
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  }

  .trust-strip__inner {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 0 1.5rem;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .trust-strip__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    flex: 1 1 0;
    justify-content: center;
    min-width: 200px;
    text-align: center;
  }

  .trust-strip__icon {
    flex-shrink: 0;
    width: 52px;
    height: 52px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .trust-strip__icon svg {
    width: 48px;
    height: 48px;
  }

  .trust-strip__icon img {
    width: 52px;
    height: 52px;
    object-fit: contain;
  }

  .trust-strip__label {
    font-size: 1.3rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: {{ section.settings.text_color }};
    line-height: 1.3;
  }

  @media screen and (max-width: 749px) {
    .trust-strip__inner {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 2.4rem 1.6rem;
      align-items: start;
      justify-items: center;
      padding: 0 2rem;
    }

    .trust-strip__item {
      min-width: unset;
    }

    /* Center the last item if odd count */
    .trust-strip__item:last-child:nth-child(odd) {
      grid-column: 1 / -1;
    }
  }
{%- endstyle -%}

<section class="trust-strip">
  <div class="trust-strip__inner">
    {%- for block in section.blocks -%}
      <div class="trust-strip__item" {{ block.shopify_attributes }}>
        <div class="trust-strip__icon">
          {%- if block.settings.custom_image != blank -%}
            <img
              src="{{ block.settings.custom_image | image_url: width: 72 }}"
              alt="{{ block.settings.label | escape }}"
              width="36"
              height="36"
              loading="lazy"
            >
          {%- elsif block.settings.asset_image != blank -%}
            <img
              src="{{ block.settings.asset_image | asset_url }}"
              alt="{{ block.settings.label | escape }}"
              width="36"
              height="36"
              loading="lazy"
            >
          {%- elsif block.settings.icon == 'certificate' -%}
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="{{ section.settings.icon_color }}" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 3h16a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1z"/>
              <path d="M8 21h8"/>
              <path d="M12 17v4"/>
              <circle cx="12" cy="10" r="3"/>
              <path d="M7 7h.01M17 7h.01"/>
            </svg>
          {%- elsif block.settings.icon == 'clock' -%}
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="{{ section.settings.icon_color }}" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"/>
              <polyline points="12 6 12 12 16 14"/>
            </svg>
          {%- elsif block.settings.icon == 'leaf' -%}
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="{{ section.settings.icon_color }}" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M17 8C8 10 5.9 16.17 3.82 21.34l1.89.66.95-2.3c.48.17.98.3 1.34.3C19 20 22 3 22 3c-1 2-8 2.25-13 3.25S2 11.5 2 13.5s1.75 3.75 1.75 3.75"/>
            </svg>
          {%- elsif block.settings.icon == 'spa' -%}
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="{{ section.settings.icon_color }}" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22c-4.97 0-9-2.24-9-5v-.02C5.02 16.2 8.26 15 12 15s6.98 1.2 8.98 1.98L21 17c0 2.76-4.03 5-9 5z"/>
              <path d="M12 15V2"/>
              <path d="M8 5c0 0 1.5 2 4 2s4-2 4-2"/>
              <path d="M7 8c0 0 2 3 5 3s5-3 5-3"/>
              <path d="M7.5 11.5c0 0 2 2.5 4.5 2.5s4.5-2.5 4.5-2.5"/>
            </svg>
          {%- elsif block.settings.icon == 'clinical' -%}
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="{{ section.settings.icon_color }}" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M10 2v6.292a4 4 0 0 0-1.17 2.833L7.46 19.5a2.5 2.5 0 0 0 2.49 2.5h4.1a2.5 2.5 0 0 0 2.49-2.5l-1.37-8.375A4 4 0 0 0 14 8.292V2"/>
              <path d="M8.5 2h7"/>
              <path d="M7.5 16h9"/>
            </svg>
          {%- else -%}
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="{{ section.settings.icon_color }}" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2z"/>
            </svg>
          {%- endif -%}
        </div>
        <span class="trust-strip__label">{{ block.settings.label }}</span>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Trust Strip",
  "tag": "section",
  "class": "trust-strip-section",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#f0ede8"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#2c2c2c"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "default": "#81806e"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 20
    }
  ],
  "blocks": [
    {
      "type": "trust_item",
      "name": "Trust Item",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Trust item"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "certificate", "label": "Certificate" },
            { "value": "clock", "label": "Clock / Experience" },
            { "value": "leaf", "label": "Leaf / Natural" },
            { "value": "spa", "label": "Spa / Professional" },
            { "value": "clinical", "label": "Clinical / Beaker" },
            { "value": "star", "label": "Star" },
            { "value": "none", "label": "None (use custom image)" }
          ],
          "default": "star"
        },
        {
          "type": "image_picker",
          "id": "custom_image",
          "label": "Custom icon image (overrides icon)"
        },
        {
          "type": "text",
          "id": "asset_image",
          "label": "Asset filename (overrides icon if no custom image)",
          "info": "e.g. logo-cidesco.webp"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust Strip",
      "blocks": [
        {
          "type": "trust_item",
          "settings": {
            "label": "CIDESCO Certified",
            "icon": "none",
            "asset_image": "logo-cidesco.webp"
          }
        },
        {
          "type": "trust_item",
          "settings": {
            "label": "30+ Years Clinical Experience",
            "icon": "clock"
          }
        },
        {
          "type": "trust_item",
          "settings": {
            "label": "Clean, Natural Ingredients",
            "icon": "leaf"
          }
        },
        {
          "type": "trust_item",
          "settings": {
            "label": "Professional Spa Formulas",
            "icon": "spa"
          }
        }
      ]
    }
  ]
}
{% endschema %}
