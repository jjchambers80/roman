{% comment %}
  Roman Skin Care — Build Your Own Bundle
  Tiered-discount bundle builder: customer picks items from a collection,
  client-side JS tracks count, sticky footer shows progress + coaching copy,
  CONTINUE batches a cart/add.js call then redirects through the matching
  discount code's auto-apply URL. No subscriptions, no app dependency.
{% endcomment %}
{{ 'component-bundle-builder.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign bundle_collection = section.settings.collection
  if bundle_collection == blank
    assign bundle_collection = collections['all-products']
  endif
-%}

<bundle-builder
  class="bundle-builder"
  data-add-label="{{ 'bundle.add_to_bundle' | t | escape }}"
  data-remove-label="{{ 'bundle.remove' | t | escape }}"
  data-empty-text="{{ 'bundle.empty' | t | escape }}"
  data-progress-zero="{{ 'bundle.progress_zero' | t | escape }}"
  data-progress-one-more-template="{{ 'bundle.progress_one_more' | t: percent: '__PERCENT__' | escape }}"
  data-progress-more-template="{{ 'bundle.progress_more' | t: count: '__COUNT__', percent: '__PERCENT__' | escape }}"
  data-progress-unlocked-template="{{ 'bundle.progress_unlocked' | t: percent: '__PERCENT__' | escape }}"
  data-continue-template="{{ 'bundle.continue_button' | t: count: '__COUNT__' | escape }}"
  data-adding-to-cart="{{ 'bundle.adding_to_cart' | t | escape }}"
  data-preview-empty-title="Select a product"
  data-preview-empty-subtitle="Unlock discounts"
  data-preview-start-title="Build your Roman bundle"
  data-preview-active-title="Bundle started"
  data-preview-complete-title="Best bundle discount unlocked"
  data-preview-selected-eyebrow="In your bundle"
  data-preview-empty-eyebrow-template="Slot __SLOT__"
  data-preview-slot-copy="Choose any Roman product"
  data-preview-next-slot-copy="Keep building your routine"
  data-preview-unlock-template="Unlock __PERCENT__ off here"
  data-preview-best-template="Best value: __PERCENT__ off"
>
  <div class="bundle-builder__header page-width">
    {%- if section.settings.heading != blank -%}
      <h1 class="bundle-builder__heading">{{ section.settings.heading }}</h1>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <div class="bundle-builder__subheading">{{ section.settings.subheading }}</div>
    {%- endif -%}
  </div>

  <div class="bundle-builder__layout page-width">
    <div class="bundle-builder__grid">
      {%- for product in bundle_collection.products -%}
        {% render 'bundle-builder-item', product: product %}
      {%- endfor -%}
    </div>

    <aside class="bundle-builder__footer" data-bundle-footer aria-label="Bundle cart preview">
      <div class="bundle-builder__footer-inner">
        <div class="bundle-builder__status">
          <p class="bundle-builder__status-title" data-bundle-status-title></p>
          <p class="bundle-builder__progress-text" data-bundle-progress-text></p>
        </div>

        <div class="bundle-builder__summary" data-bundle-summary>
          <ul class="bundle-builder__line-items" data-bundle-line-items aria-live="polite">
            {%- for slot in (1..5) -%}
              {%- liquid
                assign placeholder_copy = 'Choose any Roman product'
                if slot == 3
                  assign placeholder_copy = 'Unlock 15% off here'
                elsif slot == 4
                  assign placeholder_copy = 'Unlock 20% off here'
                elsif slot == 5
                  assign placeholder_copy = 'Best value: 25% off'
                elsif slot > 1
                  assign placeholder_copy = 'Keep building your routine'
                endif
              -%}
              <li class="bundle-builder__line-item bundle-builder__line-item--placeholder" aria-hidden="true">
                <div class="bundle-builder__line-media">
                  <span class="bundle-builder__placeholder-bottle" aria-hidden="true"></span>
                </div>
                <div class="bundle-builder__line-body">
                  <p class="bundle-builder__line-eyebrow">Slot {{ slot }}</p>
                  <p class="bundle-builder__line-title">Select a product</p>
                  <p class="bundle-builder__line-placeholder-copy">{{ placeholder_copy }}</p>
                </div>
              </li>
            {%- endfor -%}
          </ul>
        </div>

        <div class="bundle-builder__checkout">
          <div class="bundle-builder__tier-meter" aria-hidden="true">
            <div class="bundle-builder__progress-track">
              <div class="bundle-builder__progress-fill" data-bundle-progress-fill style="width: 0%"></div>
            </div>
            <div
              class="bundle-builder__tier-marker bundle-builder__tier-marker--start"
              data-bundle-tier-marker
              data-min="0"
              style="--tier-position: 0%"
            >
              <span class="bundle-builder__tier-bubble">Start</span>
            </div>
            <div
              class="bundle-builder__tier-marker"
              data-bundle-tier-marker
              data-min="3"
              style="--tier-position: 60%"
            >
              <span class="bundle-builder__tier-bubble">15% off</span>
            </div>
            <div
              class="bundle-builder__tier-marker"
              data-bundle-tier-marker
              data-min="4"
              style="--tier-position: 80%"
            >
              <span class="bundle-builder__tier-bubble">20% off</span>
            </div>
            <div
              class="bundle-builder__tier-marker"
              data-bundle-tier-marker
              data-min="5"
              style="--tier-position: 100%"
            >
              <span class="bundle-builder__tier-bubble">25% off</span>
            </div>
          </div>

          <p class="bundle-builder__fine-print">One-time order. Discount applies automatically in cart.</p>

          <button
            type="button"
            class="bundle-builder__continue"
            data-bundle-continue
            disabled
          >
            <span data-bundle-continue-label>Continue</span>
            <span class="bundle-builder__continue-prices" data-bundle-continue-prices></span>
          </button>
        </div>
      </div>
    </aside>
  </div>
</bundle-builder>

<script src="{{ 'bundle-builder.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Bundle Builder",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Build Your Own Bundle"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>Mix and match your favorites. The more you add, the more you save.</p>"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Bundle-eligible collection",
      "info": "Defaults to the All Products collection if left blank."
    }
  ],
  "presets": [
    {
      "name": "Bundle Builder"
    }
  ]
}
{% endschema %}
