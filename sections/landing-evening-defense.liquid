{{ 'section-landing-morning.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Evening Defense System Landing Page
  A single section with hero + 4 product feature rows
  Reuses the same CSS as the Morning Defense landing page
{%- endcomment -%}

{%- comment -%} ===== Bundle variant collection ===== {%- endcomment -%}
{%- assign bundle_products = section.settings.bundle_products -%}
{%- assign fbt_total_price = 0 -%}
{%- assign fbt_total_compare = 0 -%}
{%- assign fbt_all_available = true -%}
{%- assign fbt_variant_ids = '' -%}

{%- for bp in bundle_products -%}
  {%- assign bp_variant = bp.selected_or_first_available_variant -%}
  {%- if bp_variant.available == false -%}
    {%- assign fbt_all_available = false -%}
  {%- endif -%}
  {%- assign fbt_total_price = fbt_total_price | plus: bp_variant.price -%}
  {%- if bp_variant.compare_at_price and bp_variant.compare_at_price > bp_variant.price -%}
    {%- assign fbt_total_compare = fbt_total_compare | plus: bp_variant.compare_at_price -%}
  {%- else -%}
    {%- assign fbt_total_compare = fbt_total_compare | plus: bp_variant.price -%}
  {%- endif -%}
  {%- if forloop.first -%}
    {%- assign fbt_variant_ids = bp_variant.id -%}
  {%- else -%}
    {%- assign fbt_variant_ids = fbt_variant_ids | append: ',' | append: bp_variant.id -%}
  {%- endif -%}
{%- endfor -%}

{%- assign fbt_discount = section.settings.discount_percentage -%}
{%- if fbt_discount > 0 -%}
  {%- assign fbt_multiplier = 100 | minus: fbt_discount -%}
  {%- assign fbt_discounted = fbt_total_price | times: fbt_multiplier | divided_by: 100 -%}
  {%- assign fbt_has_discount = true -%}
{%- else -%}
  {%- assign fbt_discounted = fbt_total_price -%}
  {%- assign fbt_has_discount = false -%}
{%- endif -%}

{%- assign fbt_show_compare = false -%}
{%- if fbt_has_discount and fbt_discounted < fbt_total_price -%}
  {%- assign fbt_show_compare = true -%}
  {%- assign fbt_display_price = fbt_discounted -%}
  {%- assign fbt_compare_price = fbt_total_price -%}
{%- elsif fbt_total_compare > fbt_total_price -%}
  {%- assign fbt_show_compare = true -%}
  {%- assign fbt_display_price = fbt_total_price -%}
  {%- assign fbt_compare_price = fbt_total_compare -%}
{%- else -%}
  {%- assign fbt_display_price = fbt_total_price -%}
{%- endif -%}

{%- comment -%} Build button label with optional discount {%- endcomment -%}
{%- assign btn_label = section.settings.button_label | default: 'Add Bundle' -%}
{%- if fbt_discount > 0 -%}
  {%- assign btn_label = btn_label | append: ' (' | append: fbt_discount | append: '% OFF)' -%}
{%- endif -%}

{%- comment -%} ===== HERO BANNER ===== {%- endcomment -%}
<frequently-bought-together class="landing-hero-bundle-wrapper">
<div class="landing-hero">
  <div class="landing-hero__inner">
    <div class="landing-hero__content">
      <h1 class="landing-hero__heading">Evening Defense System</h1>
      <p class="landing-hero__text">
        Wind down with a four-step nighttime ritual that cleanses, calms, repairs, and deeply restores. Our ultra-mild Gentle Milk Cleanser, soothing Gentle Toner, HA&nbsp;&amp;&nbsp;Peptide Eye Cream, and luxurious Multi-Peptide Cream work in harmony to melt away the day, flood skin with active nourishment, and supercharge overnight renewal—so you wake up to a complexion that looks rested, radiant, and visibly renewed.
      </p>

      {%- if bundle_products.size > 0 -%}
        <div class="landing-hero__bundle">
          <button
            type="button"
            class="landing-hero__cta landing-hero__cta--button"
            data-bundle-add
            data-variant-ids='[{{ fbt_variant_ids }}]'
            {% unless fbt_all_available %}aria-disabled="true"{% endunless %}
          >
            <span class="landing-hero__cta-label">
              {%- if fbt_all_available -%}
                {{ btn_label }}
              {%- else -%}
                Sold Out
              {%- endif -%}
            </span>
            <div class="loading__spinner hidden">
              {%- render 'loading-spinner' -%}
            </div>
          </button>

          <div class="landing-hero__price-row">
            <span class="landing-hero__price-sale">{{ fbt_display_price | money_with_currency }}</span>
            {%- if fbt_show_compare -%}
              <s class="landing-hero__price-compare">{{ fbt_compare_price | money_with_currency }}</s>
            {%- endif -%}
          </div>

          {%- if fbt_discount > 0 -%}
            <p class="landing-hero__discount-note">
              {{ fbt_discount }}% bundle discount applied automatically at checkout
            </p>
          {%- endif -%}

          <div class="frequently-bought-together__error" role="alert"></div>
        </div>
      {%- else -%}
        <a href="#product-1" class="landing-hero__cta">Explore the Routine</a>
      {%- endif -%}
    </div>
    <div class="landing-hero__media">
      <img
        src="{{ 'routine-evening-1.png' | asset_url }}"
        alt="Roman Skin Evening Defense System — four-step nighttime ritual"
        loading="eager"
        fetchpriority="high"
        class="landing-hero__image"
        width="900"
        height="900"
      >
    </div>
  </div>
</div>

</frequently-bought-together>

{%- comment -%} ===== STEP 1: GENTLE MILK CLEANSER (image left) ===== {%- endcomment -%}
<div id="product-1" class="landing-product">
  <div class="landing-product__inner">
    <div class="landing-product__media">
      <img
        src="{{ 'product-gentle-milk-cleanser.webp' | asset_url }}"
        alt="Roman Skin Gentle Milk Cleanser"
        loading="lazy"
        class="landing-product__image"
        width="800"
        height="800"
      >
    </div>
    <div class="landing-product__content">
      <span class="landing-product__eyebrow">Step 1 — Cleanse</span>
      <h2 class="landing-product__heading">Gentle Milk Cleanser</h2>
      <span class="landing-product__skin-badge">
        <svg class="landing-product__badge-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        Dry &amp; Sensitive-Leaning Skin
      </span>
      <p class="landing-product__text">
        Your evening ritual starts with a clean slate. This creamy cleansing milk dissolves dirt and makeup without stripping away natural moisture. Shea butter, natural oils, and botanical extracts help leave skin feeling soft, comfortable, and nourished. The formula contains fragrance, so fragrance-sensitive shoppers should review the ingredient list before use.
      </p>
      <p class="landing-product__usage">
        Massage a pea-size amount onto damp skin for one minute. Rinse with warm water.
      </p>
      <a href="/products/gentle-cleansing-milk" class="landing-product__cta">View Product</a>
    </div>
  </div>
</div>

{%- comment -%} ===== STEP 2: GENTLE TONER (image right) ===== {%- endcomment -%}
<div class="landing-product landing-product--alt landing-product--image-right">
  <div class="landing-product__inner">
    <div class="landing-product__media">
      <img
        src="{{ 'product-gentle-toner-bottle.webp' | asset_url }}"
        alt="Roman Skin Gentle Toner"
        loading="lazy"
        class="landing-product__image"
        width="800"
        height="800"
      >
    </div>
    <div class="landing-product__content">
      <span class="landing-product__eyebrow">Step 2 — Tone &amp; Calm</span>
      <h2 class="landing-product__heading">Gentle Toner</h2>
      <span class="landing-product__skin-badge">
        <svg class="landing-product__badge-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        Ultra-Sensitive &amp; Dry/Sensitive Skin
      </span>
      <p class="landing-product__text">
        A deep breath for freshly cleansed skin. This pH-balanced botanical toner sweeps away every last trace of residue while flooding the complexion with an intensive burst of calming nourishment. Color-, fragrance-, and paraben-free—built for even the most reactive skin. Balanced, hydrated, and primed for everything that follows.
      </p>
      <p class="landing-product__usage">
        Sweep over face and neck with a cotton pad after cleansing. Follow with treatment serum or cream.
      </p>
      <a href="/products/gentle-toner" class="landing-product__cta">View Product</a>
    </div>
  </div>
</div>

{%- comment -%} ===== STEP 3: HA & PEPTIDE EYE CREAM (image left) ===== {%- endcomment -%}
<div class="landing-product">
  <div class="landing-product__inner">
    <div class="landing-product__media">
      <img
        src="{{ 'product-ha-peptide.webp' | asset_url }}"
        alt="Roman Skin HA & Peptide Eye Cream"
        loading="lazy"
        class="landing-product__image"
        width="800"
        height="800"
      >
    </div>
    <div class="landing-product__content">
      <span class="landing-product__eyebrow">Step 3 — Revitalize Eyes</span>
      <h2 class="landing-product__heading">HA &amp; Peptide Eye Cream</h2>
      <span class="landing-product__skin-badge">
        <svg class="landing-product__badge-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        All Skin Types &amp; Mature Skin
      </span>
      <p class="landing-product__text">
        The delicate eye area deserves its own overnight hero. Hyaluronic Acid and pseudo-Collagen deeply hydrate while revitalizing Peptides work beneath the surface to restore suppleness and vibrancy. Botanical extracts, vitamins, and natural illuminators brighten tired eyes—so mornings look rested, not rushed.
      </p>
      <p class="landing-product__usage">
        Tap 1–2 drops gently around the orbital bone, above and below the eye. Use AM &amp; PM.
      </p>
      <a href="/products/ha-peptide-eye-creme" class="landing-product__cta">View Product</a>
    </div>
  </div>
</div>

{%- comment -%} ===== STEP 4: MULTI-PEPTIDE CREAM (image right) ===== {%- endcomment -%}
<div class="landing-product landing-product--alt landing-product--image-right">
  <div class="landing-product__inner">
    <div class="landing-product__media">
      <img
        src="{{ 'product-multi-peptide-cream.webp' | asset_url }}"
        alt="Roman Skin Multi-Peptide Cream"
        loading="lazy"
        class="landing-product__image"
        width="800"
        height="800"
      >
    </div>
    <div class="landing-product__content">
      <span class="landing-product__eyebrow">Step 4 — Restore &amp; Seal</span>
      <h2 class="landing-product__heading">Multi-Peptide Cream</h2>
      <span class="landing-product__skin-badge">
        <svg class="landing-product__badge-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        All Skin Types
      </span>
      <p class="landing-product__text">
        Seal in your entire evening ritual with this luxurious peptide-rich moisturizer. Hexa- and Tetrapeptides visibly renew skin's texture while Sodium Hyaluronate and Aloe Vera deliver deep, lasting hydration. Natural-source lipids revive the complexion and combat overnight dryness—wake up to skin that feels impossibly soft, supple, and luminous.
      </p>
      <p class="landing-product__usage">
        Warm a small amount between palms and smooth over face and neck as the final step.
      </p>
      <a href="/products/multi-peptide-moisture-creme" class="landing-product__cta">View Product</a>
    </div>
  </div>
</div>

<script src="{{ 'frequently-bought-together.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Evening Defense",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "product_list",
      "id": "bundle_products",
      "label": "Bundle products",
      "limit": 4
    },
    {
      "type": "range",
      "id": "discount_percentage",
      "label": "Bundle discount %",
      "min": 0,
      "max": 30,
      "step": 5,
      "default": 0,
      "info": "Display-only. Pair with a Shopify automatic discount."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Add Bundle"
    }
  ],
  "presets": [
    {
      "name": "Evening Defense"
    }
  ]
}
{% endschema %}
